


allSubdirs:=$(shell ls -d zlib libtiff hypre foamxm 2>/dev/null)
$(info Thirdparty: $(allSubdirs) )
all: $(allSubdirs)


.PHONY:  clean pocketpy $(allSubdirs)

export msRoot ?= $(abspath ..)
export MS_INST ?= $(abspath ..)
$(info msRoot: ${msRoot}   ***   MS_INST: ${MS_INST} *** OPT: ${OPT})

msBuild=${MS_INST}/build

CmakeOpts= -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_SHARED_LIBS=False  -DCMAKE_INSTALL_PREFIX=${MS_INST}  -DCMAKE_TOOLCHAIN_FILE=${msRoot}/src/script/toolchain${OPT}.txt


ms3rd ?= ${CURDIR}
$(info ms3rd set to ${ms3rd})



biltT=$(shell [ -d ${ms3rd}/libtiff ] && [ ! -f ${MS_INST}/lib/libtiffxx.a ] && echo Tiff)
libtiff:
	[ Tiff != "$(biltT)" ] || (mkdir -p $(msBuild)/libtif )
	[ Tiff != "$(biltT)" ] || (cd       $(msBuild)/libtif && cmake ${CmakeOpts} ${ms3rd}/libtiff)
	[ Tiff != "$(biltT)" ] || (cd       $(msBuild)/libtif && $(MAKE) install)


biltHP=$(shell [ -d ${ms3rd}/hypre/src ] && [ ! -f ${MS_INST}/lib/libHYPRE.a ] && echo Hypre)
hyprePar:
	[ Hypre != "$(biltHP)" ] || (mkdir -p $(msBuild)/hyprePar )
	[ Hypre != "$(biltHP)" ] || (cd       $(msBuild)/hyprePar && cmake ${CmakeOpts}  -DHYPRE_WITH_OPENMP=ON  -DHYPRE_WITH_MPI=OFF  ${ms3rd}/hypre/src )
	[ Hypre != "$(biltHP)" ] || (cd       $(msBuild)/hyprePar && $(MAKE) install)


biltH=$(shell [ -d ${ms3rd}/hypre/src ] && [ ! -f ${MS_INST}/lib/libHYPRESeq.a ] && echo HypreSq)
hypre:
	[ HypreSq != "$(biltH)" ] || (mkdir -p $(msBuild)/hypreSeq )
	[ HypreSq != "$(biltH)" ] || (cd       $(msBuild)/hypreSeq && cmake  -DHYPRE_WITH_MPI=OFF  -DHYPRE_SEQUENTIAL=ON ${CmakeOpts} ${ms3rd}/hypre/src )
	[ HypreSq != "$(biltH)" ] || (cd       $(msBuild)/hypreSeq && $(MAKE) install)
	[ HypreSq != "$(biltH)" ] || (mv    ${MS_INST}/lib/libHYPRE.a  ${MS_INST}/lib/libHYPRESeq.a)

#hypreDbg:
#	(cp -r hypre-2.11.2 hypre-2.11.2Dbg)
#	(cd hypre-2.11.2Dbg/src && ./configure --enable-debug --without-MPI   --without-fei  CC=gcc-6  F77=gfortran CPP=g++-6  CXX=g++  AR=ar\ -rcu   RANLIB=ranlib )
#	(cd hypre-2.11.2Dbg/src && make)


biltZ=$(shell [ -d ${ms3rd}/zlib ] && [ ! -f ${MS_INST}/lib/libz.a ] && echo Zlib)

biltP=$(shell [ -d ${POCKETPY_DIR} ] && [ ! -f ${MS_INST}/lib/libpocketpy.a ] && echo PocketPy)
pocketpy:
	[ PocketPy != "$(biltP)" ] || ( \
	  mkdir -p ${msBuild}/pocketpy && cd ${msBuild}/pocketpy && \
	  cmake ${CmakeOpts} -DPK_BUILD_STATIC_LIB=ON -DPK_BUILD_SHARED_LIB=OFF -DPK_BUILD_STATIC_MAIN=OFF -DPK_BUILD_MATH_TESTS=OFF -DPK_BUILD_MODULE_LZ4=OFF -DPK_BUILD_MODULE_CUTE_PNG=OFF -DPK_BUILD_MODULE_MSGPACK=OFF -DPK_BUILD_MODULE_PERIPHERY=OFF ${POCKETPY_DIR} && \
	  $(MAKE) install \
	)


zlib:
	[ Zlib  != "$(biltZ)" ] || (mkdir -p $(msBuild)/zlib )
	[ Zlib  != "$(biltZ)" ] || (cd       $(msBuild)/zlib &&  cmake ${CmakeOpts} ${ms3rd}/zlib)
	[ Zlib  != "$(biltZ)" ] || (cd       $(msBuild)/zlib && $(MAKE) install)


lPng=$(shell [ -d ${ms3rd}/libpng ] && [ ! -f ${MS_INST}/lib/libpng.a ] && echo lPng)
libpng:
	[ lPng  != "$(lPng)" ] || (cd  ${ms3rd}/libpng && $(MAKE) all OPT=${OPT})

ifneq "${OPT}" ".exe"
biltF=$(shell [ -d foamxm ] && [ ! -f ${MS_INST}/lib/libfiniteVolume*.so ] && echo Foam)
foamxm:
	@echo biltF: $(biltF)
	+ [ Foam  != "$(biltF)" ] || (mkdir -p ${msBuild}/foamxm                      ) || echo  skipping mkdir foamxm
	+ [ Foam  != "$(biltF)" ] || (rsync -art --update foamxm ${msBuild}/          ) || echo  skipping rsync foamxm
	+ [ Foam  != "$(biltF)" ] || (cd ${msBuild}/foamxm  && ./AllMak${OPT}e        ) || echo  skipping AllMak${OPT}e foamxm
	[   Foam  != "$(biltF)" ] || (cd ${msBuild}/foamxm  && ./AllInstall  ${MS_INST}) || echo  skipping AllInstall foamxm
else
foamxm:; @echo skipping foamxm
endif

clean:
	(cd foamxm  2>/dev/null  &&  ./AllDistclean) || echo !!

distclean:
	(cd foamxm  2>/dev/null  &&  ./AllDistclean) || echo !!
