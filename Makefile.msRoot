#!/bin/make
# Makefile for top ($msRoot) directory

# order matters
curMkfil:=$(lastword $(MAKEFILE_LIST))

export msRoot ?= ${CURDIR}
# msSrc: folder with script/ (this folder in a flat checkout, else ./src)
export msSrc ?= $(if $(wildcard ${CURDIR}/script/Makefile.in),${CURDIR},${CURDIR}/src)
export ms3rd ?= $(if $(wildcard ${msRoot}/pkgs),${msRoot}/pkgs,${msSrc}/pkgs)
export msTree := $(if $(filter src,$(notdir ${msSrc})),$(notdir $(abspath ${msSrc}/..)),$(notdir ${msSrc}))

# Use .env file to set MS_INST, MS_TEST_DIR and/or msBilDir vars
ifneq ($(wildcard ${msRoot}/.env),)
  include ${msRoot}/.env
endif

ifdef HWLOC_COMPONENTS
  export HWLOC_COMPONENTS  # e.g. -opencl, see .env.example
endif
export POCKETPY_DIR ?= ${ms3rd}/pocketpy
export HYPRE_SRC ?= ${ms3rd}/hypre
export FOAMXM_SRC ?= ${ms3rd}/foamxm
export MS_INST ?= ${msRoot}/inst
export msBilDir ?= ${msRoot}/build
export MS_TEST_DIR ?= ${msRoot}/test_runs
export LD_LIBRARY_PATH := ${MS_INST}/lib:$(LD_LIBRARY_PATH)
export PATH := ${MS_INST}/bin:${MS_INST}/bin/foamxm:$(PATH)


#nproc = $(shell $(( $nproc < 1 ? 4 : $nproc )))
#nproc = $(shell $(( $nproc > 31 ? 31 : $nproc )))


# Build for Linux
all:            checkRoot
	mkdir -p ${MS_INST}/lib
	mkdir -p ${MS_INST}/bin
	mkdir -p ${MS_INST}/include
	(cd ${ms3rd} && $(MAKE) -f ${msSrc}/script/makefile.3rd  zlib)
	(cd ${ms3rd} && $(MAKE) -f ${msSrc}/script/makefile.3rd )
	(cd ${ms3rd} && $(MAKE) -f ${msSrc}/script/makefile.3rd pocketpy)
	(cd ${msSrc} && $(MAKE) -f ${msSrc}/script/Makefile.in recurseMake USE_msRecurse=1)
	+$(MAKE) post_all
	@echo done

# Hook for a parent project: it can add (double-colon) recipes of its own, run after 'all', in the top level Makefile
post_all::;

# Build for Windows
mgw:            checkRoot
	mkdir -p ${MS_INST}/lib
	mkdir -p ${MS_INST}/bin
	mkdir -p ${MS_INST}/include
	(cd ${ms3rd} && $(MAKE) -f ${msSrc}/script/makefile.3rd  OPT=.exe)
	(cd ${msSrc} && $(MAKE) -f ${msSrc}/script/Makefile.in recurseMake  OPT=.exe USE_msRecurse=1)
	(cd ${MS_INST}/bin && make -f ${msSrc}/script/Makefile.msRoot  checksum) || echo check checksum
	@echo done


clean:          checkRoot
	(cd ${ms3rd} && $(MAKE) -f ${msSrc}/script/makefile.3rd  clean)
	(cd ${msSrc} && $(MAKE) -f ${msSrc}/script/Makefile.in recurseClean USE_msRecurse=1)
	rm -rf  ${msBilDir}/${msTree} ${msSrc}/*/__pycache__  log.make

distclean:      checkRoot clean
	@echo "\n\nWarning:\n\n   deleting log.make, bin/, include/, lib/, share/ and test/, in 10s\n"
	@bash -c 'read -t 10 -p "   press Entre to proceed,  Ctrl+c to stop? "' || echo deleting
	sleep 2
	rm -rf   ${MS_INST}/bin  ${MS_INST}/include  ${MS_INST}/lib  ${MS_INST}/share ${MS_INST}/test
	(cd ${ms3rd} && $(MAKE) -f ${msSrc}/script/makefile.3rd  distclean)

checkRoot:
	@echo  "${msSrc}/script/Makefile.msRoot == $(abspath ${curMkfil})? "
	@[ "$(abspath ${msSrc}/script/Makefile.msRoot)" = "$(abspath ${curMkfil})" ] || (echo Error: ran make from wrong directory && false)
	@$(if $(filter 1,${MS_ALLOW_OUTSIDE}),,$(foreach d,${MS_INST} ${msBilDir} ${MS_TEST_DIR}, [ -n "$(filter ${CURDIR}/% ${CURDIR},$(abspath ${d}))" ] || (echo "Error: ${d} is outside ${CURDIR}, check .env and your environment (or set MS_ALLOW_OUTSIDE=1)" && false);))
	@echo  :/


checksum:
	sha256sum *.exe > checksums_sha256.md
	printf '\n\nTo validate above .exe files in Windows PowerShell, run:\n\n' >> checksums_sha256.md
	printf '    certutil -hashfile   c:path/to/file.exe   SHA256\n\n'         >> checksums_sha256.md
	printf 'and compare the output with the above SHA256 checksums.\n\n'      >> checksums_sha256.md
	printf 'Or in Linux run from the bin/ directory:\n\n'                     >> checksums_sha256.md
	printf '    sha256sum -c checksums_sha256.md\n\n'                         >> checksums_sha256.md


run_tests: checkRoot
	(cd ${msSrc} && $(MAKE) -f ${msSrc}/script/Makefile.in recurseTest USE_msRecurse=1)

# Failing tests are detected by non-zero exit codes (run_tests). Suspicious messages in the log files are only printed in red.
# testDeps: extra prerequisites (tests) of a parent project, set before including this file
test: checkRoot ${testDeps} run_tests
	@echo "\n\033[34m Checking the test logs: \033[0m\n"
	@for cas in $(shell find ${MS_TEST_DIR}/ -type f | grep log) ; do \
		(! grep -3 -E '\bError\b|\bFATAL|terminate called|\bAborted|\bAborting|: error'  $${cas} ) \
		|| printf "\n\n^^^\033[91m Error in $${cas} \033[0m \n================================================\n\n"; \
	done
	@echo "\033[34m Tests finished, check the messages in red above, if any \033[0m"


# not used yet
installDir?=$(HOME)/.local/
install:
	mkdir -p $(installDir)bin/
	cp -rp ${MS_INST}/bin  $(installDir)
	cp -rp ${MS_INST}/lib  $(installDir)
	cp -rp ${msSrc}/script $(installDir)bin/
